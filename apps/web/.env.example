# apps/web — frontend environment variables (Vite). Only VITE_* keys reach the browser bundle.
# Copy to .env.local and fill in. Every value below is OPTIONAL: if an ID is unset,
# that platform's pixel script and tracking calls are skipped silently (no errors).

# ── Ad / analytics pixels (dormant until their ID is set) ──────────────────────
# Used by src/lib/tracking.ts + <PixelScripts/>. See LANDING_DESIGN.md and the
# cross-platform event mapping in src/lib/tracking.ts.

# Meta (Facebook) Pixel ID — fires fbq PageView / ViewContent / Lead /
# CompleteRegistration / InitiateCheckout / Purchase.
VITE_META_PIXEL_ID=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX) — gtag config + events.
VITE_GA4_ID=

# Google Ads conversion ID (e.g. AW-XXXXXXXXXX) — loaded via the same gtag.js
# loader; conversion labels are configured in Google Ads, not here.
VITE_GOOGLE_ADS_ID=

# TikTok Pixel ID — ttq PageView / ViewContent / SubmitForm / CompleteRegistration /
# InitiateCheckout / CompletePayment.
VITE_TIKTOK_PIXEL_ID=

# ── Web push (already used by src/lib/pwa.ts) ─────────────────────────────────
VITE_VAPID_PUBLIC_KEY=
