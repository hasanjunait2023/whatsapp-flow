# Server runtime configuration (apps/server)
# Required
AUTH_SECRET=change-me-to-a-32+char-random-secret

# Optional (defaults shown)
PORT=3000
DB_PATH=./data/app.db
MEDIA_DIR=./data/media
NODE_ENV=development
# AUTH_BASE_URL=http://localhost:3000
# WEB_DIST_DIR=../web/dist

# --- WAHA (WhatsApp HTTP API) ---
# Base URL of the WAHA REST API. Pilot: http://127.0.0.1:3999. Prod (same compose
# network as the app): http://waha:3000
WAHA_URL=http://127.0.0.1:3999
# API key sent as X-Api-Key on every WAHA request (pilot key in /data/waha-pilot/.pilot-env)
WAHA_API_KEY=
# true = WAHA Core/pilot (single 'default' session, all instances map to it).
# false = WAHA Plus (session name = instance_id, one session per tenant instance).
WAHA_SINGLE_SESSION=true
# Public base URL WAHA uses to reach our webhook. Prod: http://app:3000 (container-to-container).
# WAHA_WEBHOOK_BASE_URL=http://localhost:3000
# HMAC secret WAHA Plus signs webhooks with. When set (or WAHA_WEBHOOK_REQUIRE_HMAC=true),
# every webhook MUST carry a valid X-Webhook-Hmac signature or it is rejected (401).
# PRODUCTION WITH WAHA PLUS MUST SET THIS. Unset is allowed ONLY for the loopback
# Core/pilot; the server logs a startup warning when verification is disabled.
# WAHA_WEBHOOK_HMAC_SECRET=
# Force HMAC enforcement even before a secret is wired (a misconfig then rejects all
# webhooks rather than accepting unsigned ones). Default false.
# WAHA_WEBHOOK_REQUIRE_HMAC=false

# --- Secrets at rest ---
# AES-256-GCM master key for stored secrets (tenant LLM API keys, page tokens).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# --- LLM providers (Soul / Hermes / CEO agents) ---
# Platform keys; tenants may also bring their own key (BYOK) via Settings.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Default provider/model when a tenant/plan has none configured.
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-2.0-flash

# --- Agent Soul ingestion ---
# FB page scraping fallback stays OFF (Meta ToS); Graph API + website crawl only.
# FB_GRAPH_VERSION=v21.0

# --- Facebook Login (one-click page connect via OAuth) ---
# Meta app credentials (developers.facebook.com > your app > Settings > Basic).
# Add FB_OAUTH_REDIRECT_URL to "Valid OAuth Redirect URIs" in FB Login settings.
# Requested permissions: pages_show_list, pages_messaging, pages_manage_metadata,
# pages_read_engagement, pages_manage_engagement, pages_manage_posts.
# FB_APP_ID=
# FB_APP_SECRET=
# FB_OAUTH_REDIRECT_URL=https://<your-domain>/api/fb/oauth/callback
# Optional: Facebook Login for Business configuration id (overrides scope list).
# FB_LOGIN_CONFIG_ID=

# --- Telegram (CEO agent reports; single platform bot) ---
# Create a bot with @BotFather, then set the webhook to
#   https://<your-domain>/api/telegram/webhook  (secret_token = TELEGRAM_WEBHOOK_SECRET)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# --- CEO marketing research (optional; off by default) ---
# CEO_RESEARCH_ENABLED=false
# TAVILY_API_KEY=

# --- Crypto payments (manual USDT transfer) ---
# Platform receiving addresses; leave empty to disable a network.
# CRYPTO_USDT_ADDRESS_TRC20=
# CRYPTO_USDT_ADDRESS_BEP20=

# --- Web push (PWA notifications) ---
# Generate once: npx web-push generate-vapid-keys
# Public key must also be set as VITE_VAPID_PUBLIC_KEY in apps/web.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# --- Phase-4 data migration (Supabase Postgres -> SQLite) ---
# Used ONLY by scripts/migrate-from-pg.ts. Provide the source Postgres direct
# connection string here (or as DATABASE_URL) when running the one-off import:
#   DATABASE_URL=... pnpm --filter server exec tsx scripts/migrate-from-pg.ts
# NEVER commit a real connection string. Either var works; DATABASE_URL wins.
# SUPABASE_DB_URL=postgres://USER:PASS@HOST:5432/postgres
# DATABASE_URL=

# --- Google sign-in for tenant owners (better-auth socialProviders) ---
# OAuth client from Google Cloud Console; redirect URI:
#   https://<your-domain>/api/auth/callback/google
# Team members keep email/password; non-owner Google sign-ins are rejected.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
