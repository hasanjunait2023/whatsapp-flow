# Server runtime configuration (apps/server)
# Required
AUTH_SECRET=change-me-to-a-32+char-random-secret

# Optional (defaults shown)
PORT=3000
DB_PATH=./data/app.db
MEDIA_DIR=./data/media
NODE_ENV=development
# AUTH_BASE_URL=http://localhost:3000
# WEB_DIST_DIR=../web/dist

# --- WAHA (WhatsApp HTTP API) ---
# Base URL of the WAHA REST API. Pilot: http://127.0.0.1:3999. Prod (same compose
# network as the app): http://waha:3000
WAHA_URL=http://127.0.0.1:3999
# API key sent as X-Api-Key on every WAHA request (pilot key in /data/waha-pilot/.pilot-env)
WAHA_API_KEY=
# true = WAHA Core/pilot (single 'default' session, all instances map to it).
# false = WAHA Plus (session name = instance_id, one session per tenant instance).
WAHA_SINGLE_SESSION=true
# Public base URL WAHA uses to reach our webhook. Prod: http://app:3000 (container-to-container).
# WAHA_WEBHOOK_BASE_URL=http://localhost:3000
# HMAC secret WAHA Plus signs webhooks with. When set (or WAHA_WEBHOOK_REQUIRE_HMAC=true),
# every webhook MUST carry a valid X-Webhook-Hmac signature or it is rejected (401).
# PRODUCTION WITH WAHA PLUS MUST SET THIS. Unset is allowed ONLY for the loopback
# Core/pilot; the server logs a startup warning when verification is disabled.
# WAHA_WEBHOOK_HMAC_SECRET=
# Force HMAC enforcement even before a secret is wired (a misconfig then rejects all
# webhooks rather than accepting unsigned ones). Default false.
# WAHA_WEBHOOK_REQUIRE_HMAC=false
