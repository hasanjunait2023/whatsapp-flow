# ===========================================================================
# whatsapp-flow — PRODUCTION env (Contabo VPS)
#
# Copy to `.env.production` and fill in. NEVER commit the filled file.
# Names only here — empty values. Cross-referenced with apps/server/.env.example
# so the container has everything it needs; infra vars (R2/restic) added.
#
# Generate secrets:
#   AUTH_SECRET   : openssl rand -hex 32
#   MASTER_KEY    : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   WAHA_API_KEY  : openssl rand -hex 24
#   *_WEBHOOK_SECRET / HMAC : openssl rand -hex 32
# ===========================================================================

# --- Core runtime (most are pinned in docker-compose; listed for clarity) ---
NODE_ENV=production
# PORT/DB_PATH/MEDIA_DIR/WEB_DIST_DIR are set in docker-compose.yml — do not
# override here unless you know why.

# --- Auth (REQUIRED) --------------------------------------------------------
# Signing secret for better-auth. 32+ chars.
AUTH_SECRET=
# Public origin the app is served from (same-origin in prod), e.g.
# https://app.junno.qzz.io  — must match the nginx server_name + Cloudflare host.
AUTH_BASE_URL=

# --- Secrets at rest (REQUIRED) ---------------------------------------------
# AES-256-GCM master key for stored tenant secrets. EXACTLY 64 hex chars.
MASTER_KEY=

# --- WAHA (REQUIRED) --------------------------------------------------------
# WAHA_URL / WAHA_WEBHOOK_BASE_URL / WAHA_SINGLE_SESSION are set in compose
# (http://waha:3000, http://app:3500, false). Only the secrets go here.
# API key shared between the app (X-Api-Key) and the waha container (WHATSAPP_API_KEY).
WAHA_API_KEY=
# HMAC secret WAHA Plus signs webhooks with. PRODUCTION WITH PLUS MUST SET THIS
# (otherwise the server logs a startup warning and webhooks are unauthenticated).
WAHA_WEBHOOK_HMAC_SECRET=
# Force HMAC enforcement even before the secret propagates. Recommended: true.
WAHA_WEBHOOK_REQUIRE_HMAC=

# --- Cloudflare R2 — SQLite replication (litestream) + backups (restic) -----
# R2 is S3-compatible. Create a bucket + an R2 API token (Object Read & Write).
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Litestream reads the keys under AWS_* names — set these to the same values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- restic — media + WAHA session backups ----------------------------------
# A restic repo on the SAME R2 bucket (or a second one), e.g.
#   s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>/restic
RESTIC_REPOSITORY=
# Encryption password for the restic repo (generate + store safely; losing it
# means the backups are unrecoverable).
RESTIC_PASSWORD=

# --- LLM providers (OPTIONAL — agents: Soul / Hermes / CEO) ------------------
# Platform keys; tenants may also BYOK via Settings. Set at least one if AI is on.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Default provider/model when a tenant/plan has none configured.
LLM_DEFAULT_PROVIDER=
LLM_DEFAULT_MODEL=

# --- Telegram (OPTIONAL — CEO agent reports; single platform bot) -----------
# Webhook: https://<your-domain>/api/telegram/webhook (secret_token = below).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- CEO marketing research (OPTIONAL; off by default) ----------------------
CEO_RESEARCH_ENABLED=
TAVILY_API_KEY=

# --- Crypto payments (OPTIONAL — manual USDT transfer) ----------------------
# Platform receiving addresses; leave empty to disable a network.
CRYPTO_USDT_ADDRESS_TRC20=
CRYPTO_USDT_ADDRESS_BEP20=

# --- UddoktaPay (OPTIONAL — BDT gateway) ------------------------------------
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_BASE_URL=

# --- Web push / PWA notifications (OPTIONAL) ---------------------------------
# Generate once: npx web-push generate-vapid-keys
# The PUBLIC key must ALSO be built into the web app as VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Facebook / Meta (OPTIONAL — Messenger + page webhooks) -----------------
FB_GRAPH_VERSION=
FB_WEBHOOK_VERIFY_TOKEN=
# Facebook Login page-connect OAuth (Meta app > Settings > Basic).
# Redirect URI (add in FB Login settings): https://<your-domain>/api/fb/oauth/callback
# (derived from AUTH_BASE_URL automatically; FB_OAUTH_REDIRECT_URL only to override)
FB_APP_ID=
FB_APP_SECRET=
# Optional Facebook Login for Business configuration id (overrides scope list).
FB_LOGIN_CONFIG_ID=

# --- Google sign-in for tenant owners (OPTIONAL — better-auth social) -------
# Redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
