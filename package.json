{
  "name": "whatsapp-flow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter web build && pnpm --filter server build",
    "test": "pnpm --filter server test && pnpm --filter web test",
    "migrate": "pnpm --filter server migrate",
    "seed": "pnpm --filter server seed"
  }
}
