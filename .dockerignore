# Keep the build context small and never leak local state/secrets into images.
**/node_modules
**/dist
**/dist-ssr
**/.turbo
**/.cache

# Local data + SQLite (the image starts from a FRESH DB on a mounted volume)
data/
**/data/
# ...but the SSG content source lives under a dir literally named data/
# (apps/web/src/content/data/{compare,learn}.tsx). Keep it in the build context.
!apps/web/src/content/data
!apps/web/src/content/data/**
*.db
*.db-shm
*.db-wal
*.sqlite

# Secrets / local env — never copy into the image
.env
.env.*
!.env.production.example

# VCS + tooling
.git
.github
.claude

# Logs + editor
*.log
.vscode
.idea
.DS_Store
